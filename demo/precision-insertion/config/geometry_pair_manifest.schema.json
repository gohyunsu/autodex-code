{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snuvclab.org/schemas/geometry-pair-manifest-v1.json",
  "title": "Precision assembly geometry pair manifest",
  "description": "Versioned geometry, split and metrology contract for cross-geometry assembly research.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pair_id",
    "generator",
    "split",
    "part",
    "fixture",
    "task",
    "symmetry",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "geometry_pair_manifest_v1"},
    "pair_id": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "name", "version", "parameters"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "split": {
      "enum": [
        "train_instance",
        "validation_instance",
        "test_instance",
        "test_family",
        "test_physical"
      ]
    },
    "tier": {"enum": ["prismatic", "spatial"]},
    "part": {"$ref": "#/$defs/rigidAsset"},
    "fixture": {"$ref": "#/$defs/rigidAsset"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insertion_axis_fixture",
        "seated_transform_fixture_part",
        "seated_depth_m",
        "clearance"
      ],
      "properties": {
        "insertion_axis_fixture": {"$ref": "#/$defs/vector3"},
        "seated_transform_fixture_part": {"$ref": "#/$defs/matrix4"},
        "seated_depth_m": {"type": "number", "exclusiveMinimum": 0},
        "clearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "nominal_m"],
          "properties": {
            "definition": {"type": "string", "minLength": 1},
            "nominal_m": {"type": "number", "minimum": 0},
            "minimum_m": {"type": ["number", "null"], "minimum": 0},
            "maximum_m": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "success_contract_id": {"type": ["string", "null"]}
      }
    },
    "symmetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_type", "equivalence_definition"],
      "properties": {
        "group_type": {
          "enum": ["identity", "finite", "continuous_axial", "custom"]
        },
        "equivalence_definition": {"type": "string", "minLength": 1},
        "finite_transforms": {
          "type": "array",
          "items": {"$ref": "#/$defs/matrix4"}
        },
        "continuous_axis_part": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/vector3"}
          ]
        }
      }
    },
    "manufacturing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "process": {"type": ["string", "null"]},
        "material": {"type": ["string", "null"]},
        "part_serial": {"type": ["string", "null"]},
        "fixture_serial": {"type": ["string", "null"]},
        "metrology_report": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "manifest_revision"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "manifest_revision": {"type": "string", "minLength": 1},
        "generator_code_revision": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "rigidAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "visual_mesh", "collision_mesh", "datum_transform"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "visual_mesh": {"$ref": "#/$defs/fileRef"},
        "collision_mesh": {"$ref": "#/$defs/fileRef"},
        "datum_transform": {"$ref": "#/$defs/matrix4"},
        "mass_kg": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "matrix4": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "number"},
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
