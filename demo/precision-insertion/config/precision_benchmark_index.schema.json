{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snuvclab.org/schemas/precision-benchmark-index-v1.json",
  "title": "Zero-shot precision benchmark index",
  "description": "Authoritative case identities used to audit Z1-Z4 train/test leakage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": "precision_benchmark_index_v1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "partition",
          "geometry_family",
          "layout_family",
          "base_policy_class",
          "program_path"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "partition": {"enum": ["train", "validation", "test"]},
          "geometry_family": {"type": "string", "minLength": 1},
          "layout_family": {"type": "string", "minLength": 1},
          "base_policy_class": {"type": "string", "minLength": 1},
          "program_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
