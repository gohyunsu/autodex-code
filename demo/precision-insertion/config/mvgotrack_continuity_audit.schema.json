{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snuvclab.org/schemas/precision-insertion-mvgotrack-continuity-audit-v1.json",
  "title": "MV-GoTrack physical episode continuity audit",
  "description": "Offline research evidence only. This document never changes live robot motion or runtime failure policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "interval",
    "verdict",
    "evidence_refs"
  ],
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {
        "required": [
          "attempt_id",
          "first_seq",
          "last_seq",
          "sample_count",
          "phase_sample_counts",
          "interval_unix_ns",
          "sequence_strictly_increasing",
          "calibration_sessions",
          "objects"
        ]
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "precision_insertion_mvgotrack_continuity_audit_v1"
    },
    "run_id": {"type": "string", "minLength": 1},
    "interval": {"const": "pickup_start_to_precontact_hold"},
    "verdict": {"enum": ["pass", "fail"]},
    "attempt_id": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1},
    "candidate_attempt_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "first_seq": {"type": "integer", "minimum": 0},
    "last_seq": {"type": "integer", "minimum": 1},
    "sample_count": {"type": "integer", "minimum": 4},
    "native_invalid_sample_count": {"type": "integer", "minimum": 0},
    "sequence_strictly_increasing": {"type": "boolean"},
    "calibration_sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "phase_sample_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pickup", "lift", "transfer", "precontact_hold"],
      "properties": {
        "pickup": {"type": "integer", "minimum": 1},
        "lift": {"type": "integer", "minimum": 1},
        "transfer": {"type": "integer", "minimum": 1},
        "precontact_hold": {"type": "integer", "minimum": 1}
      }
    },
    "interval_unix_ns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pickup_start", "precontact_hold"],
      "properties": {
        "pickup_start": {"type": "integer", "minimum": 0},
        "precontact_hold": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {"type": "null"},
        "pose_jump": {"type": "null"},
        "workspace": {"type": "null"},
        "maximum_interframe_gap": {"type": "null"}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
