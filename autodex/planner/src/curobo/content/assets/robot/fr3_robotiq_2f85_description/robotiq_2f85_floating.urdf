    <child link="robotiq_mount" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100" lower="-6.28318530718" upper="6.28318530718" velocity="4" />
  </joint>
  <joint name="floating_to_robotiq" type="fixed">
    <parent link="robotiq_mount" />
    <child link="robotiq_85_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
