<?xml version='1.0' encoding='utf-8'?>
<robot name="robotiq_2f85_floating">
  <link name="world" />
  <link name="x_link" />
  <joint name="x_joint" type="prismatic">
    <parent link="world" />
    <child link="x_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="100" lower="-2" upper="2" velocity="4" />
  </joint>
  <link name="y_link" />
  <joint name="y_joint" type="prismatic">
    <parent link="x_link" />
    <child link="y_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="100" lower="-2" upper="2" velocity="4" />
  </joint>
  <link name="z_link" />
