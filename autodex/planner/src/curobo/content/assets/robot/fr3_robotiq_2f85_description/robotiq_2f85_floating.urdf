    <parent link="y_link" />
    <child link="z_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100" lower="-2" upper="2" velocity="4" />
  </joint>
  <link name="rx_link" />
